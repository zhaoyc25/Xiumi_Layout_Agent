# 使用方法：复制本文件到 secrets/config.env，然后把等号后面换成你自己的值。
# cp secrets.example/config.env.example secrets/config.env
# 本文件只放格式示例，禁止填入真实密钥。

# ========== LLM（现在就要填，chat 对话用） ==========

# 你的 API Key（在平台后台生成，一般是 sk- 开头）
XIUMI_LLM_API_KEY=在这里填你的APIKey

# API 地址（[OI] 兼容接口的 base_url，注意一般以 /v1 结尾，不带末尾斜杠）
XIUMI_LLM_BASE_URL=在这里填API地址例如https://open.bigmodel.cn/api/paas/v4

# 模型名（用哪个模型就填哪个，如 glm-4.6 / glm-4-flash）
XIUMI_LLM_MODEL=在这里填模型名例如glm-4.6

# ========== 图床（M7 才会用，现在可以先不填） ==========

# 图床/云存储的访问令牌
XIUMI_IMAGE_HOST_TOKEN=在这里填图床Token

# 图床/云存储的 API 地址
XIUMI_IMAGE_HOST_BASE_URL=在这里填图床地址
